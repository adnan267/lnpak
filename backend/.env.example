DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lnpak_db
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=https://lnpak.com,http://localhost:5173
NODE_ENV=production
PORT=5000
# Set to 1 when the API runs behind a proxy (Render, Railway, Nginx) so rate limiting sees the real visitor IP
TRUST_PROXY=1
# Optional: override the live exchange-rate source
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/USD
